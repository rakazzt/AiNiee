            "options": [
                {"key": "provider_order", "type": "string-list", "vehicle": "extra_body", "path": "provider.order", "label": {"简中": "提供商顺序", "English": "Provider order"}, "desc": {"简中": "按顺序尝试的提供商 slug，每行一个", "English": "Provider slugs to try in order, one per line"}},
                {"key": "provider_only", "type": "string-list", "vehicle": "extra_body", "path": "provider.only", "label": {"简中": "仅允许的提供商", "English": "Only these providers"}, "desc": {"简中": "白名单，留空表示不限制", "English": "Allow-list; empty means no restriction"}},
                {"key": "provider_ignore", "type": "string-list", "vehicle": "extra_body", "path": "provider.ignore", "label": {"简中": "忽略的提供商", "English": "Ignore these providers"}},
                {"key": "provider_sort", "type": "enum", "values": ["price", "throughput", "latency", "exacto"], "vehicle": "extra_body", "path": "provider.sort", "label": {"简中": "排序策略", "English": "Routing sort"}, "desc": {"简中": "未指定顺序时按此排序", "English": "Used when no explicit order is given"}},
                {"key": "provider_quantizations", "type": "string-list", "vehicle": "extra_body", "path": "provider.quantizations", "label": {"简中": "量化精度过滤", "English": "Quantizations"}, "desc": {"简中": "如 int4 / fp8 / bf16，每行一个", "English": "e.g. int4, fp8, bf16 - one per line"}},
                {"key": "provider_allow_fallbacks", "type": "bool", "vehicle": "extra_body", "path": "provider.allow_fallbacks", "label": {"简中": "允许回退到其他提供商", "English": "Allow fallbacks"}},
                {"key": "provider_require_parameters", "type": "bool", "vehicle": "extra_body", "path": "provider.require_parameters", "label": {"简中": "仅用支持全部参数的提供商", "English": "Require parameter support"}, "desc": {"简中": "关闭时提供商会忽略它不支持的参数", "English": "When off, providers silently drop parameters they do not support"}},
                {"key": "provider_data_collection", "type": "enum", "values": ["deny", "allow"], "vehicle": "extra_body", "path": "provider.data_collection", "label": {"简中": "数据收集策略", "English": "Data collection"}, "desc": {"简中": "deny 表示只用不收集数据的提供商", "English": "deny restricts routing to providers that do not retain data"}},
                {"key": "provider_zdr", "type": "bool", "vehicle": "extra_body", "path": "provider.zdr", "label": {"简中": "仅零留存端点", "English": "Zero data retention only"}, "desc": {"简中": "只使用不保留提示词的端点", "English": "Only endpoints that do not retain prompts"}},
                {"key": "provider_enforce_distillable_text", "type": "bool", "vehicle": "extra_body", "path": "provider.enforce_distillable_text", "label": {"简中": "仅允许可蒸馏文本的模型", "English": "Distillable text only"}},
                {"key": "provider_max_price_prompt", "type": "string", "vehicle": "extra_body", "path": "provider.max_price.prompt", "label": {"简中": "输入价格上限 (USD/百万 token)", "English": "Max prompt price (USD per M tokens)"}},
                {"key": "provider_max_price_completion", "type": "string", "vehicle": "extra_body", "path": "provider.max_price.completion", "label": {"简中": "输出价格上限 (USD/百万 token)", "English": "Max completion price (USD per M tokens)"}},
                {"key": "provider_preferred_max_latency", "type": "number-or-object", "vehicle": "extra_body", "path": "provider.preferred_max_latency", "label": {"简中": "偏好最大延迟（秒）", "English": "Preferred max latency (s)"}},
                {"key": "provider_preferred_min_throughput", "type": "number-or-object", "vehicle": "extra_body", "path": "provider.preferred_min_throughput", "label": {"简中": "偏好最小吞吐 (token/s)", "English": "Preferred min throughput (tok/s)"}},
                {"key": "fallback_models", "type": "string-list", "vehicle": "extra_body", "path": "models", "label": {"简中": "备用模型（按顺序回退）", "English": "Fallback models"}, "desc": {"简中": "主模型不可用时依次尝试，每行一个", "English": "Tried in order when the primary model is unavailable"}},
                {"key": "reasoning_summary", "type": "enum", "values": ["auto", "concise", "detailed"], "vehicle": "extra_body", "path": "reasoning.summary", "label": {"简中": "思考摘要详细度", "English": "Reasoning summary"}}
